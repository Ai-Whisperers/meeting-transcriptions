# Copy this file to `.env` and fill in the values. The `.env` file is
# git-ignored. These defaults match the working setup validated on 2026-08-28.

# === Drive ingest (public folder mode — RECOMMENDED, no auth needed) ===
# Folder ID extracted from the share link. Already pointing at the right folder.
MT_DRIVE_FOLDER=1iuz-q9fPxup4MZjuRLSs3U3iw6FmgIF2

# === LiteLLM gateway ===
# The hermes-litellm proxy at llm.paragu-ai.com routes to multiple models.
# Only some are currently funded; the rest return 402/404.
MT_LITELLM_BASE_URL=https://llm.paragu-ai.com/v1
MT_LITELLM_API_KEY=sk-hermes-litellm-sunstein-2026
# Working models (tested 2026-08-28):
#   openai/zai-glm-4-flash     ✅ works (Z.ai GLM 4 flash, free)
#   openai/zai-glm-4-flash-exp ✅ works (newer)
#   openai/cerebras-gpt-oss-120b ❌ 402 (Cerebras credits exhausted)
#   openai/cerebras-zai-glm     ❌ 402 (same)
#   openai/nvidia-llama-8b      ❌ 410 (model EOL)
MT_LITELLM_MODEL=openai/zai-glm-4-flash

# === HuggingFace (for pyannote diarization) ===
# Get one at https://huggingface.co/settings/tokens
# Also accept the EULAs at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-embedding
HF_TOKEN=

# === WhisperX model selection ===
# medium is the default — good Spanish, ~1.5GB, balanced speed/quality
# Options: tiny | base | small | medium | large-v3
MT_WHISPER_MODEL=medium

# === Pipeline paths ===
# MT_INBOX=/opt/data/inbox/meetings
# MT_INDEX=/opt/data/indexed/meetings

# === Cross-meeting linking window (days) ===
MT_LINK_WINDOW_DAYS=30